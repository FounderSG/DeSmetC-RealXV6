        FORKTEST.C  ---644 0 0 ../../drive_c/XV6/USR/FORKTEST.C
        GREP.C      ---644 0 0 ../../drive_c/XV6/USR/GREP.C
        ID.C        ---644 0 0 ../../drive_c/XV6/USR/ID.C
        KILL.C      ---644 0 0 ../../drive_c/XV6/USR/KILL.C
        LN.C        ---644 0 0 ../../drive_c/XV6/USR/LN.C
