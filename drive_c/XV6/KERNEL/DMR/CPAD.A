; CPAD.A -- code-segment spacer.  FIRST in the BIND list, contributes no
; DSEG, so real code is linked at 100H and up and absolute code offsets
; (the bdevsw/cdevsw function-pointer tables, the values setvect writes
; into interrupt vectors) stay correct once the image loads at 100H.
; e2c strips these bytes.  INT 3 so a stray jump here traps.
	CSEG
	PUBLIC	CPADS
CPADS:
	DB	0CCH,0CCH,0CCH,0CCH,0CCH,0CCH,0CCH,0CCH
	DB	0CCH,0CCH,0CCH,0CCH,0CCH,0CCH,0CCH,0CCH
